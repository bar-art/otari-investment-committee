# Otari gateway. Hosted: https://api.otari.ai/api/v1  Self-hosted: http://localhost:8000/api/v1
OTARI_BASE_URL=https://api.otari.ai/api/v1
OTARI_API_KEY=

# Optional: one Otari virtual key per agent, each with its own budget in the dashboard.
# Unset roles use OTARI_API_KEY.
# OTARI_API_KEY_FUNDAMENTAL=
# OTARI_API_KEY_TECHNICAL=
# OTARI_API_KEY_EVENTS=
# OTARI_API_KEY_BULL=
# OTARI_API_KEY_BEAR=
# OTARI_API_KEY_JUDGE=
# OTARI_API_KEY_RISK=

# SEC asks automated clients to identify themselves ("Name contact@domain")
SEC_USER_AGENT=your-name your-email@example.com

# Hard risk limits (code-enforced, no LLM can loosen them)
MAX_WEIGHT=0.10
MAX_SECTOR_WEIGHT=0.30
VOL_BUDGET=0.03
ES_BUDGET=0.004
DRAWDOWN_STOP=0.15

# --- Otari features ---
# Service key for per-user budgets (dashboard: API keys > Advanced > Service key)
# Budget id that new end users start on (GET /end-user-budgets)
OTARI_END_USER_BUDGET=
OTARI_SERVICE_KEY=
# Read the latest 8-K through Otari web fetch (needs Tools > Web search > Allow in workspace)
OTARI_WEB_FETCH=0
# Recompute VaR/ES in Otari's code sandbox before any BUY
OTARI_CODE_CHECK=1
# Guardrail on untrusted text (8-K body, headlines); empty = off
OTARI_GUARDRAIL_PROFILE=
OTARI_GUARDRAIL_MODE=block
# Judge tiers down to the economy model when its key has less than this left
JUDGE_BUDGET_FLOOR_USD=0.50
